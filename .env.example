# Copy to .env and fill in. .env is gitignored; never commit real keys.
# A real exported environment variable always wins over anything set here.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Required for `--submit` scoring (sb-cli reads this from the environment).
# Generate one with: sb-cli gen-api-key <your-email>
# SWEBENCH_API_KEY=swb-...

# Optional overrides (defaults shown).
# PATCHPILOT_MODEL=claude-sonnet-5
# PATCHPILOT_STEP_CAP=40
# PATCHPILOT_RUNS_DIR=runs
